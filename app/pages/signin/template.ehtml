import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { signin } from "#app/shared/services/auth";
import { initials } from "#app/shared/services/format";
import { Alert } from "@elements/ui/alert";
import { Avatar } from "@elements/ui/avatar";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

export interface DemoLogin {
  name: string;
  email: string;
  role: "customer" | "admin";
}

export const DEMO_PASSWORD = "wishcairn";

export const DEMO_EMAILS = [
  "maya@wishcairn.dev",
  "theo@wishcairn.dev",
  "priya@example.com",
  "jonas@example.com",
  "amara@example.com",
  "lucas@example.com",
  "hana@example.com",
  "diego@example.com",
  "erin@example.com",
  "kofi@example.com",
  "sofia@example.com",
  "ben@example.com",
];

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SigninForm, next: string) {
  form.busy = true;

  try {
    signin(form.email, form.password);
    form.error = "";
    redirect(next);
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function onDemo(form: SigninForm, login: DemoLogin, next: string) {
  form.email = login.email;
  form.password = DEMO_PASSWORD;
  onSubmit(form, next);
}

<html lang="en" class="page-signin" (
  next: string,
  demo: DemoLogin[],
  private form: SigninForm = { email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · wishcairn</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="auth">
        <Card>
          <CardContent>
            <form class="auth-form stack" onsubmit={() => onSubmit(form, next)}>
              <div class="stack is-xs">
                <h1>Sign in</h1>
                <p class="text-ink-soft">Vote, comment, and hear when your requests move.</p>
              </div>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Email">
                <Input type="email"
                       required
                       name="email"
                       value={form.email}
                       placeholder="you@company.com"
                       attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password">
                <Input type="password"
                       required
                       name="password"
                       value={form.password}
                       attrs={{ id: "password", autocomplete: "current-password" }} />
              </Field>

              <Button type="submit" variant="primary" block loading={form.busy}>Sign in</Button>

              <p class="text-sm text-ink-soft">New here? <a href="/signup">Create an account</a></p>
            </form>
          </CardContent>
        </Card>

        <Card e:if={demo.length > 0} title="Demo accounts" level={2}>
          <CardContent class="stack">
            <p class="text-sm text-ink-soft">
              Every account's password is <code>{DEMO_PASSWORD}</code>. Pick one to sign in as that person.
            </p>

            <DemoGroup title="Team" logins={demo.filter((d) => d.role === "admin")} {form} {next} />
            <DemoGroup title="Customers" logins={demo.filter((d) => d.role === "customer")} {form} {next} />
          </CardContent>
        </Card>
      </div>
    </Layout>
  </body>
</html>

<DemoGroup (
  title: string,
  logins: DemoLogin[],
  form: SigninForm,
  next: string,
)>
  <div class="stack is-xs">
    <p class="eyebrow">{title}</p>
    <ul class="demo-list demo-grid">
      <li e:for={login of logins}>
        <Button variant="ghost"
                class="demo-login"
                disabled={form.busy}
                onclick={() => onDemo(form, login, next)}>
          <Avatar size="sm" fallback={initials(login.name)} class={login.role === "admin" ? "is-team" : ""} />
          <span class="demo-login-who">
            <span>{login.name}</span>
            <span class="demo-login-email">{login.email}</span>
          </span>
        </Button>
      </li>
    </ul>
  </div>
</DemoGroup>
