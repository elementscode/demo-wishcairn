import "./style.css";
import { LiveView, session } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { VoteButton, StatusPill } from "#app/shared/templates/request-bits";
import {
  FeatureRequest,
  Vote,
  Comment,
  MAX_COMMENT,
  setStatus,
  mergeRequest,
} from "#app/shared/services/board";
import { STATUSES, statusLabel } from "#app/shared/services/status";
import { timeAgo, longDate, plural, initials } from "#app/shared/services/format";
import { Alert, AlertDescription } from "@elements/ui/alert";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Avatar } from "@elements/ui/avatar";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { NativeSelect } from "@elements/ui/native-select";
import { Select } from "@elements/ui/select";
import { Textarea } from "@elements/ui/textarea";

export interface ShippedIn {
  id: string;
  title: string;
  version: string;
  publishedAt: Date;
}

interface Draft {
  body: string;
  error: string;
}

interface MergeForm {
  targetId: string;
  confirming: boolean;
  busy: boolean;
  error: string;
}

export function postComment(comments: LiveView<Comment>, draft: Draft) {
  let body = draft.body.trim();

  if (!body) {
    return;
  }

  draft.error = "";

  try {
    comments.insert(
      {
        userId: session.getOrThrow("userId"),
        userName: session.getOrThrow("userName"),
        isTeam: session.get("role") === "admin",
        kind: "comment",
        body,
        createdAt: new Date(),
      },
      () => draft.body = "",
    );
  } catch (err: any) {
    draft.error = err.message;
    draft.body = body;
  }
}

function canDelete(comment: Comment): boolean {
  return comment.kind === "comment" &&
    (comment.userId === session.get("userId") || session.get("role") === "admin");
}

function thread(comments: LiveView<Comment>): Comment[] {
  return comments.sort((a, b) => +a.createdAt - +b.createdAt);
}

function onStatus(requestId: string, status: string, result: { error: string }) {
  result.error = "";

  try {
    setStatus(requestId, status);
  } catch (err: any) {
    result.error = err.message;
  }
}

function onMerge(sourceId: string, form: MergeForm) {
  form.busy = true;
  form.error = "";

  try {
    mergeRequest(sourceId, form.targetId);
    form.confirming = false;
  } catch (err: any) {
    form.error = err.message;
  }

  form.busy = false;
}

function mergeCandidates(requests: LiveView<FeatureRequest>, id: string): { value: string; label: string }[] {
  return requests
    .filter((r) => r.id !== id && !r.mergedIntoId)
    .sort((a, b) => a.title.localeCompare(b.title))
    .map((r) => ({ value: r.id, label: r.title }));
}

const STATUS_OPTIONS = STATUSES.map((s) => ({ value: s, label: statusLabel(s) }));

<html lang="en" class="page-request" (
  id: string,
  requests: LiveView<FeatureRequest>,
  votes?: LiveView<Vote> | undefined,
  comments: LiveView<Comment>,
  shippedIn: ShippedIn[],
)>
  <head>
    <title>{requests.find((r) => r.id === id)?.title ?? "Request"} · wishcairn</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout current="board">
      <RequestDetail e:if={requests.find((r) => r.id === id)}
                     request={requests.find((r) => r.id === id)!}
                     merged={requests.find((r) => r.id === requests.find((x) => x.id === id)?.mergedIntoId)}
                     {requests}
                     {votes}
                     {comments}
                     {shippedIn} />
      <div e:else class="stack">
        <h1>This request was removed</h1>
        <p><a href="/">Back to all requests</a></p>
      </div>
    </Layout>
  </body>
</html>

<RequestDetail (
  request: FeatureRequest,
  merged?: FeatureRequest | undefined,
  requests: LiveView<FeatureRequest>,
  votes?: LiveView<Vote> | undefined,
  comments: LiveView<Comment>,
  shippedIn: ShippedIn[],
)>
  <div class="detail">
    <article class="stack is-lg">
      <a class="back-link" href="/">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All requests
      </a>

      <div class="detail-head row is-start">
        <VoteButton {request} {votes} />
        <div class="stack is-xs">
          <h1>{request.title}</h1>
          <div class="detail-meta cluster is-sm">
            <StatusPill status={request.status} />
            <span>Suggested by {request.authorName} · {timeAgo(request.createdAt)}</span>
          </div>
        </div>
      </div>

      <Alert e:if={merged} variant="info" title="Merged" role="none">
        <AlertDescription>
          The team merged this into <a href={`/requests/${merged!.id}`}>{merged!.title}</a>,
          which asks for the same thing. Votes moved there, so follow along on that request.
        </AlertDescription>
      </Alert>

      <p e:if={request.description} class="detail-desc">{request.description}</p>

      <section class="thread stack">
        <h2>Activity</h2>

        <ol class="thread-list stack is-lg" e:if={comments.length > 0}>
          <ThreadEntry e:for={c of thread(comments)} comment={c} {comments} />
        </ol>
        <p e:else class="text-ink-soft">No comments yet. Start the conversation.</p>

        <Composer e:if={session.isLoggedIn()} {comments} />
        <Alert e:else role="none">
          <AlertDescription>
            <a href={`/signin?next=/requests/${request.id}`}>Sign in</a> to vote and comment.
          </AlertDescription>
        </Alert>
      </section>
    </article>

    <aside class="detail-side stack">
      <Card>
        <CardContent class="stack">
          <dl class="detail-facts">
            <dt>Status</dt>
            <dd>{statusLabel(request.status)}</dd>
            <dt>Votes</dt>
            <dd>{request.voteCount}</dd>
            <dt>Comments</dt>
            <dd>{request.commentCount}</dd>
            <dt>Suggested</dt>
            <dd>{longDate(request.createdAt)}</dd>
          </dl>

          <div e:if={shippedIn.length > 0} class="stack is-xs">
            <p class="eyebrow">Shipped in</p>
            <a e:for={entry of shippedIn} href={`/changelog#${entry.id}`}>
              {entry.version ? `${entry.version}: ` : ""}{entry.title}
            </a>
          </div>
        </CardContent>
      </Card>

      <TeamPanel e:if={session.get("role") === "admin" && !request.mergedIntoId} {request} {requests} />
    </aside>
  </div>
</RequestDetail>

<ThreadEntry (comment: Comment, comments: LiveView<Comment>)>
  <li e:if={comment.kind === "comment"} class={["entry", comment.isTeam && "is-team"]}>
    <Avatar size="sm" fallback={initials(comment.userName)} class={comment.isTeam ? "is-team" : ""} />
    <div class="entry-body">
      <div class="entry-who row">
        <span class="entry-name">{comment.userName}</span>
        <Badge e:if={comment.isTeam} variant="accent">Team</Badge>
        <span class="entry-time">{timeAgo(comment.createdAt)}</span>
        <Button e:if={canDelete(comment)}
                variant="ghost"
                size="sm"
                class="entry-delete"
                attrs={{ "aria-label": "Delete comment" }}
                onclick={() => comments.delete(comment)}>Delete</Button>
      </div>
      <p class="entry-text">{comment.body}</p>
    </div>
  </li>

  <li e:elseif={comment.kind === "status"} class="event row">
    <span class="event-mark" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 16 16" focusable="false">
        <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span><strong>{comment.userName}</strong> moved this to</span>
    <StatusPill status={comment.body} />
    <span class="entry-time">{timeAgo(comment.createdAt)}</span>
  </li>

  <li e:else class="event row">
    <span class="event-mark" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 16 16" focusable="false">
        <path d="M4 3v3.5a3 3 0 0 0 3 3h5M4 13V9.5M10 7l2 2.5-2 2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span><strong>{comment.userName}</strong> merged "{comment.body}" into this request</span>
    <span class="entry-time">{timeAgo(comment.createdAt)}</span>
  </li>
</ThreadEntry>

<Composer (
  comments: LiveView<Comment>,
  private draft: Draft = { body: "", error: "" },
)>
  <form class="composer stack is-sm" onsubmit={() => postComment(comments, draft)}>
    <label for="comment" class="visually-hidden">Add a comment</label>
    <Textarea value={draft.body}
              maxlength={MAX_COMMENT}
              placeholder="Add a comment"
              required
              attrs={{ id: "comment" }} />
    <Alert e:if={draft.error} variant="danger" description={draft.error} />
    <div class="composer-actions row">
      <span class="text-xs text-ink-dim">Commenting as {session.get("userName")}</span>
      <Button type="submit" variant="primary" disabled={!draft.body.trim()}>Comment</Button>
    </div>
  </form>
</Composer>

<TeamPanel (
  request: FeatureRequest,
  requests: LiveView<FeatureRequest>,
  private status: string = request.status,
  private result: { error: string } = { error: "" },
  private merge: MergeForm = { targetId: "", confirming: false, busy: false, error: "" },
)>
  <Card title="Team" level={2}>
    <CardContent class="stack is-lg">
      <form class="stack is-sm" onsubmit={() => onStatus(request.id, status, result)}>
        <Field label="Status" description="Voters get an email when the status changes." error={result.error}>
          <NativeSelect value={status} options={STATUS_OPTIONS} block />
        </Field>
        <Button type="submit" disabled={status === request.status}>Update status</Button>
      </form>

      <div class="divider is-soft"></div>

      <div class="stack is-sm">
        <Field label="Merge as a duplicate of" error={merge.error}>
          <Select value={merge.targetId}
                  items={mergeCandidates(requests, request.id)}
                  placeholder="Choose a request"
                  block />
        </Field>

        <AlertDialog open={merge.confirming}
                     title="Merge this request?"
                     description={`Move ${plural(request.voteCount, "vote")} to ${requests.find((r) => r.id === merge.targetId)?.title ?? "the other request"} and close this request?`}>
          <Button slot="trigger" disabled={!merge.targetId}>Merge…</Button>
          <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction variant="danger" loading={merge.busy} onclick={() => onMerge(request.id, merge)}>Merge</AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialog>
      </div>
    </CardContent>
  </Card>
</TeamPanel>
