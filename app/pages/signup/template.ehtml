import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SignupForm) {
  form.busy = true;

  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { name: "", email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign up · wishcairn</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="auth">
        <div class="card">
          <div class="card-body">
            <form class="auth-form stack" onsubmit={() => onSubmit(form)}>
              <div class="stack is-xs">
                <h1>Create an account</h1>
                <p class="text-ink-soft">Suggest features, vote on them, and get an email when they move.</p>
              </div>

              <p e:if={form.error} class="error" role="alert">{form.error}</p>

              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" value={form.name} autocomplete="name" placeholder="Ada Lovelace" required>
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email"
                       name="email"
                       type="email"
                       value={form.email}
                       autocomplete="email"
                       autocapitalize="none"
                       spellcheck={false}
                       placeholder="you@company.com"
                       required>
              </div>

              <div class="field">
                <label for="password">Password</label>
                <input id="password"
                       name="password"
                       type="password"
                       value={form.password}
                       autocomplete="new-password"
                       minlength={MIN_PASSWORD}
                       required>
                <p class="hint">At least {MIN_PASSWORD} characters.</p>
              </div>

              <button type="submit" class="is-primary is-block" disabled={form.busy}>Create account</button>

              <p class="text-sm text-ink-soft">Have an account? <a href="/signin">Sign in</a></p>
            </form>
          </div>
        </div>
      </div>
    </Layout>
  </body>
</html>
