import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SignupForm) {
  form.busy = true;

  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { name: "", email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign up · wishcairn</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="auth">
        <Card>
          <CardContent>
            <form class="auth-form stack" onsubmit={() => onSubmit(form)}>
              <div class="stack is-xs">
                <h1>Create an account</h1>
                <p class="text-ink-soft">Suggest features, vote on them, and get an email when they move.</p>
              </div>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Name">
                <Input name="name"
                       required
                       value={form.name}
                       placeholder="Ada Lovelace"
                       attrs={{ autocomplete: "name" }} />
              </Field>

              <Field label="Email">
                <Input type="email"
                       required
                       name="email"
                       value={form.email}
                       placeholder="you@company.com"
                       attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`}>
                <Input type="password"
                       required
                       name="password"
                       value={form.password}
                       attrs={{ autocomplete: "new-password", minlength: MIN_PASSWORD }} />
              </Field>

              <Button type="submit" variant="primary" block loading={form.busy}>Create account</Button>

              <p class="text-sm text-ink-soft">Have an account? <a href="/signin">Sign in</a></p>
            </form>
          </CardContent>
        </Card>
      </div>
    </Layout>
  </body>
</html>
