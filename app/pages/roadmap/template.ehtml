import "./style.css";
import { LiveView } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { VoteButton, StatusPill } from "#app/shared/templates/request-bits";
import { FeatureRequest, Vote } from "#app/shared/services/board";
import { Status } from "#app/shared/services/status";
import { plural, timeAgo } from "#app/shared/services/format";
import { Empty } from "@elements/ui/empty";
import { Kanban, KanbanBoard, KanbanColumn, KanbanItem, KanbanNav, KanbanNavItem } from "@elements/ui/kanban";

interface Lane {
  id: string;
  status: Status;
  title: string;
  empty: string;
}

const LANES: Lane[] = [
  { id: "planned", status: "planned", title: "Planned", empty: "Nothing planned yet." },
  { id: "in_progress", status: "in_progress", title: "In progress", empty: "Nothing in progress right now." },
  { id: "shipped", status: "shipped", title: "Shipped", empty: "Nothing shipped yet." },
];

/** Shipped reads as a history, newest first; the rest rank by demand. */
export function laneRequests(requests: Iterable<FeatureRequest>, status: Status): FeatureRequest[] {
  return [...requests]
    .filter((r) => r.status === status && !r.mergedIntoId)
    .sort((a, b) =>
      status === "shipped"
        ? +b.statusChangedAt - +a.statusChangedAt
        : b.voteCount - a.voteCount || +b.createdAt - +a.createdAt,
    );
}

/** The board's columns: each lane's requests, in lane order. */
export function lanes(requests: Iterable<FeatureRequest>): Record<string, FeatureRequest[]> {
  let all = [...requests];
  let out: Record<string, FeatureRequest[]> = {};

  for (let lane of LANES) {
    out[lane.id] = laneRequests(all, lane.status);
  }

  return out;
}

<html lang="en" class="page-roadmap" (
  requests: LiveView<FeatureRequest>,
  votes?: LiveView<Vote> | undefined,
)>
  <head>
    <title>Roadmap · wishcairn</title>
    <meta name="description" content="What the Loomwork team has planned, is building, and has shipped.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout current="roadmap">
      <div class="stack is-xl">
        <header class="roadmap-intro stack is-sm">
          <p class="eyebrow">Roadmap</p>
          <h1>What we're working on</h1>
          <p class="lede">The requests the team has picked up, in the order they'll likely land. Vote to tell us what matters most.</p>
        </header>

        <Kanban value={lanes(requests)} label="Roadmap">
          <KanbanNav>
            <KanbanNavItem e:for={lane of LANES} e:key={(l) => l.id} value={lane.id}>{lane.title}</KanbanNavItem>
          </KanbanNav>
          <KanbanBoard fill>
            <KanbanColumn e:for={lane of LANES}
                          e:key={(l) => l.id}
                          value={lane.id}
                          label={lane.title}>
              <div slot="header" class="kanban-column-header lane-head">
                <StatusPill status={lane.status} />
                <span class="kanban-column-count">{laneRequests(requests, lane.status).length}</span>
              </div>

              <KanbanItem e:for={r of laneRequests(requests, lane.status)}
                          e:key={(r) => r.id}
                          value={r.id}
                          label={r.title}
                          class="lane-card">
                <VoteButton request={r} {votes} compact={true} />
                <div class="stack is-xs">
                  <a class="lane-card-title" href={`/requests/${r.id}`}>{r.title}</a>
                  <span class="lane-card-meta">
                    {plural(r.commentCount, "comment")}
                    {lane.status === "shipped" ? ` · shipped ${timeAgo(r.statusChangedAt)}` : ""}
                  </span>
                </div>
              </KanbanItem>

              <Empty slot="footer" e:if={laneRequests(requests, lane.status).length === 0} description={lane.empty} />
            </KanbanColumn>
          </KanbanBoard>
        </Kanban>
      </div>
    </Layout>
  </body>
</html>
